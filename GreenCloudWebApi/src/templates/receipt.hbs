<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Payment Receipt {{receipt.receiptNo}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Arial, sans-serif; color: #1e293b; font-size: 13px; padding: 24px; }
    .doc { max-width: 760px; margin: 0 auto; }
    .head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #1b447d; padding-bottom: 14px; margin-bottom: 18px; }
    .brand h1 { font-size: 22px; color: #1b447d; letter-spacing: 0.5px; }
    .brand .muted { color: #64748b; font-size: 11px; margin-top: 3px; line-height: 1.5; }
    .doc-tag { text-align: right; }
    .doc-tag .title { font-size: 20px; font-weight: 700; color: #0f172a; letter-spacing: 1px; }
    .doc-tag .no { margin-top: 4px; font-size: 13px; color: #1b447d; font-weight: 700; }
    .doc-tag .status { display: inline-block; margin-top: 6px; background: #dcfce7; color: #166534; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 10px; letter-spacing: 0.5px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 16px; }
    .box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; }
    .box .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.8px; color: #64748b; margin-bottom: 3px; }
    .box .value { font-size: 12.5px; font-weight: 600; color: #0f172a; }
    table { width: 100%; border-collapse: collapse; margin-top: 4px; }
    th { background: #1b447d; color: #fff; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.6px; padding: 8px 10px; }
    td { padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 12.5px; }
    .num { text-align: right; }
    .totals { margin-top: 14px; margin-left: auto; width: 300px; }
    .totals .row { display: flex; justify-content: space-between; padding: 6px 10px; font-size: 12.5px; }
    .totals .row.grand { background: #1b447d; color: #fff; font-weight: 700; border-radius: 6px; font-size: 14px; }
    .note { margin-top: 16px; font-size: 11px; color: #64748b; line-height: 1.6; }
    .sign { margin-top: 42px; display: flex; justify-content: space-between; }
    .sign div { text-align: center; width: 220px; }
    .sign .line { border-top: 1px solid #94a3b8; padding-top: 5px; font-size: 11px; color: #475569; }
    .footer { margin-top: 26px; border-top: 1px solid #e2e8f0; padding-top: 10px; text-align: center; font-size: 10px; color: #94a3b8; }
  </style>
</head>
<body>
  <div class="doc">
    <div class="head">
      <div class="brand">
        <h1>{{company.name}}</h1>
        <div class="muted">
          {{#if company.address}}{{company.address}}<br />{{/if}}
          {{#if company.phone}}Tel: {{company.phone}}{{/if}}{{#if company.email}}{{#if company.phone}} · {{/if}}{{company.email}}{{/if}}
          {{#if company.trnNumber}}<br />TRN: {{company.trnNumber}}{{/if}}
        </div>
      </div>
      <div class="doc-tag">
        <div class="title">PAYMENT RECEIPT</div>
        <div class="no">{{receipt.receiptNo}}</div>
        <span class="status">{{receipt.status}}</span>
      </div>
    </div>

    <div class="grid">
      <div class="box">
        <div class="label">Receipt Date</div>
        <div class="value">{{fmtDate receipt.receiptDate}}</div>
      </div>
      <div class="box">
        <div class="label">Received From</div>
        <div class="value">{{#if customer}}{{customer.companyName}}{{else}}—{{/if}}</div>
      </div>
      <div class="box">
        <div class="label">Invoice</div>
        <div class="value">{{#if invoice}}{{invoice.invoiceNo}}{{else}}—{{/if}}</div>
      </div>
      <div class="box">
        <div class="label">Payment Method</div>
        <div class="value">{{receipt.paymentMethod}}</div>
      </div>
      <div class="box">
        <div class="label">Transaction / Reference No</div>
        <div class="value">{{#if receipt.referenceNo}}{{receipt.referenceNo}}{{else}}—{{/if}}</div>
      </div>
      <div class="box">
        <div class="label">Installment</div>
        <div class="value">{{#if installment}}No {{installment.no}}{{else}}—{{/if}}</div>
      </div>
    </div>

    <table>
      <thead>
        <tr><th>Description</th><th class="num">Amount (AED)</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>
            Payment received{{#if invoice}} against invoice {{invoice.invoiceNo}}{{/if}}{{#if installment}} — installment {{installment.no}}{{/if}}
            {{#if installment}}<br /><span style="color:#64748b;font-size:11px">Installment amount: AED {{fmt installment.total}} · Outstanding after this receipt: AED {{fmt installment.outstanding}}</span>{{/if}}
          </td>
          <td class="num"><strong>{{fmt receipt.amount}}</strong></td>
        </tr>
      </tbody>
    </table>

    <div class="totals">
      <div class="row"><span>Received Amount</span><span>AED {{fmt receipt.amount}}</span></div>
      {{#if invoice}}
      <div class="row"><span>Invoice Total</span><span>AED {{fmt invoice.totalAmount}}</span></div>
      <div class="row"><span>Total Paid to Date</span><span>AED {{fmt invoice.amountPaid}}</span></div>
      <div class="row grand"><span>Invoice Outstanding</span><span>AED {{fmt invoiceOutstanding}}</span></div>
      {{/if}}
    </div>

    {{#if receipt.remarks}}
    <p class="note"><strong>Remarks:</strong> {{receipt.remarks}}</p>
    {{/if}}

    <div class="sign">
      <div><div class="line">Received By</div></div>
      <div><div class="line">Authorised Signature</div></div>
    </div>

    <div class="footer">
      Receipt {{receipt.receiptNo}} · Generated {{fmtDate receipt.createdAt}} · This is a system-generated document.
    </div>
  </div>
</body>
</html>
